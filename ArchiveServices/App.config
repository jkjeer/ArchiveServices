<?xml version="1.0"?>
<configuration>
  <system.diagnostics>
    <sources>
      <source name="System.ServiceModel.MessageLogging">
        <listeners>
          <add name="messages" type="System.Diagnostics.XmlWriterTraceListener" initializeData="c:\temp\ArchiveServices.svclog"/>
        </listeners>
      </source>
    </sources>
  </system.diagnostics>
  <appSettings>
    <add key="ClientSettingsProvider.ServiceUri" value=""/>
    <add key="MailFromAddress" value="svcsoa@cardinalcorp.com"/>
    <add key="MailConfirmToAddress" value="jkjeer@cardinalcorp.com"/>
    <add key="MailErrorToAddress" value="jkjeer@cardinalcorp.com"/>

		<!-- <add key="SmtpHost" value="smtp.cgi.int"/> -->
		<!-- <add key="SmtpHost" value="smtp.office365.com"/> -->
		<!-- <add key="SmtpHost" value="cardinalcorp-com.mail.protection.outlook.com"/> -->
		<add key="SmtpHost" value="smtp-postfix.cgi.int"/>
		<add key="SmtpPort" value="25"/>
		<add key="EnableSsl" value="false"/>
		<add key="UseDefaultCredentials" value="true"/>	
		<add key="SendingAccount" value="svcsoa@cardinalcorp.com"/>
		<add key="SendingPassword" value="svcsoA99"/>
		<!-- <add key="ProcessResponseFilePath" value="\\cgi.int\divisions\Everyone\Integration Service Notices"/> -->
		<add key="ProcessResponseFilePath" value="\\svcpy\s$\Integration Service Notices"/>

    <add key="PingTimeoutMs" value="4000"/>
    <add key="PingRetries" value="3"/>
	
    <add key="MinLogRetentionDays" value="2"/>
    <add key="AutoConfigDisable" value="false"/>
    <add key="AutoConfigDeleteRowsAdjust" value="false"/>
    <add key="TestModeConfig" value="false"/>
    <add key="TestModeNoDelete" value="false"/>
    <add key="TruncateRepoLedgerAfter" value="false"/>
    <add key="ArchieMaxDeleteRows" value="100000"/>
    <add key="ArchieMaxDeleteSeconds" value="5"/>
    <add key="ArchieMinRetentionDays" value="30"/>
    <add key="ArchieMinRetentionDaysTail" value="3"/>
    <add key="ArchieMinMovedRows" value="1000"/>
    <add key="ArchieNextRuntimeMoveAheadDays" value="7"/>
    <add key="ArchieConnectTimeout" value="10"/>
    <add key="ArchieMaxStatsRows" value="20000000"/>
  </appSettings>
  
  <connectionStrings>
    <add name="SOA.LOG" connectionString="Data Source=localhost;Initial Catalog=SOA;Integrated Security=SSPI;Application Name=ArchiveServices;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient"/>
    <add name="CORP.INTEGRATION" connectionString="Data Source=INTEGRATIONAG;Initial Catalog=INTEGRATION;Integrated Security=SSPI;Connection Timeout=30;MultiSubnetFailover=True;Application Name=ArchiveServices;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient"/>
    <add name="ArchieConfigServer" connectionString="Server=CGD2ARCH1;Database=Archiver;Integrated Security=SSPI;Connection Timeout=30;MultiSubnetFailover=True;Application Name=ArchiveServices;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient"/>
    <add name="ArchieRepositoryServer" connectionString="Server=CGD2ARCH1;Database=Master;Integrated Security=SSPI;Connection Timeout=30;MultiSubnetFailover=True;Application Name=ArchiveServices;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient"/>
  </connectionStrings>
  
  <system.web>
    <compilation debug="true"/>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri=""/>
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400"/>
      </providers>
    </roleManager>
  </system.web>
  <!-- When deploying the service library project, the content of the config file must be added to the host's 
  app.config file. System.Configuration does not support config files for libraries. -->
  <system.serviceModel>
    <!-- Service Bindings -->
    <bindings>
      <!-- Service Bindings -->
      <basicHttpBinding>
        <binding name="basicHttpBinding1" closeTimeout="00:10:00" openTimeout="00:10:00" sendTimeout="00:10:00" maxBufferSize="2147483647" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          <security mode="TransportCredentialOnly">
            <transport clientCredentialType="Windows"/>
          </security>
        </binding>
        <binding name="mexBindingConfig">
          <security mode="Transport">
            <transport clientCredentialType="Windows"/>
          </security>
        </binding>
      </basicHttpBinding>
      <wsHttpBinding>
        <binding name="wsHttpBinding1" closeTimeout="00:10:00" openTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          <security mode="TransportWithMessageCredential">
            <transport clientCredentialType="Windows"/>
          </security>
        </binding>
        <binding name="mexBindingConfig">
          <security mode="Transport">
            <transport clientCredentialType="Windows"/>
          </security>
        </binding>
      </wsHttpBinding>
      <netTcpBinding>
        <binding name="netTcpBinding1" closeTimeout="00:10:00" openTimeout="00:10:00" sendTimeout="00:10:00" maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
        </binding>
        <binding name="mexBindingConfig">
          <security mode="Transport">
            <transport clientCredentialType="Windows"/>
          </security>
        </binding>
      </netTcpBinding>
      <webHttpBinding>
        <binding name="webHttpBinding1" closeTimeout="00:10:00" openTimeout="00:10:00" sendTimeout="00:10:00" maxBufferSize="2147483647" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647"/>
          <security mode="TransportCredentialOnly">
            <transport clientCredentialType="Windows"/>
          </security>
        </binding>
        <binding name="mexBindingConfig">
          <security mode="TransportCredentialOnly">
            <transport clientCredentialType="Windows"/>
          </security>
        </binding>
      </webHttpBinding>
      <!-- Mex Bindings -->
      <mexHttpBinding>
        <binding name="mexBindingConfig"/>
      </mexHttpBinding>
      <mexTcpBinding>
        <binding name="mexBindingConfig"/>
      </mexTcpBinding>
    </bindings>
	
    <!-- Services -->
    <services>
      <!-- Archie Service -->
      <service behaviorConfiguration="default" name="ArchiveServices.ArchieSvc.ArchieService">
        <endpoint address="" behaviorConfiguration="LargeMessageEndpointBehavior" binding="netTcpBinding" bindingConfiguration="netTcpBinding1" contract="ArchiveServices.ArchieSvc.IArchieService">
          <identity>
            <servicePrincipalName value="CGIServices\SVCPY.cgi.int"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexTcpBinding" bindingConfiguration="mexBindingConfig" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8733/Design_Time_Addresses/ArchiveServices/ArchiveServices.ArchieSvc.ArchieService"/>
            <add baseAddress="net.tcp://localhost:8090/Design_Time_Addresses/ArchiveServices/ArchiveServices.ArchieSvc.ArchieService"/>
          </baseAddresses>
        </host>
      </service>
      <service behaviorConfiguration="default" name="ArchiveServices.ArchieSvc.ArchieRestService">
        <endpoint address="" behaviorConfiguration="webby" binding="webHttpBinding" bindingConfiguration="webHttpBinding1" contract="ArchiveServices.ArchieSvc.IArchieRestService">
          <identity>
            <dns value="localhost"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" bindingConfiguration="mexBindingConfig" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8733/Design_Time_Addresses/ArchiveServices/ArchiveServices.ArchieSvc.ArchieRestService"/>
          </baseAddresses>
        </host>
      </service>
    </services>
	  
    <!-- Behaviors -->
    <behaviors>
      <endpointBehaviors>
        <behavior name="LargeMessageEndpointBehavior">
          <dataContractSerializer maxItemsInObjectGraph="2147483647"/>
        </behavior>
        <behavior name="webby">
          <dataContractSerializer maxItemsInObjectGraph="2147483647"/>
          <webHttp/>
        </behavior>
      </endpointBehaviors>
      <serviceBehaviors>
        <behavior name="default">
          <serviceAuthorization serviceAuthorizationManagerType="SoaCore.Wcf.IG.IGServiceAuthorizationManager,SoaCore"/>
          <serviceMetadata httpGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <!-- Diagnostics -->
    <diagnostics>
      <messageLogging logEntireMessage="true" logMalformedMessages="false" logMessagesAtServiceLevel="true" logMessagesAtTransportLevel="false" maxMessagesToLog="3000" maxSizeOfMessageToLog="2000"/>
    </diagnostics>
</system.serviceModel>
<startup>
	<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
</startup>
  
<runtime>
	<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
		<dependentAssembly>
			<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
			<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.3.0"/>
		</dependentAssembly>
		
		<dependentAssembly>
		  <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
		  <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
		</dependentAssembly>

		<dependentAssembly>
		  <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
		  <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
		</dependentAssembly>
	</assemblyBinding>
</runtime>	
  
</configuration>
