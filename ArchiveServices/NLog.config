<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Info"
      internalLogFile="c:\temp\nlog-internal.log" >

  <variable name="serviceName" value="ArchiveServices"/>
  <variable name="LogDbHost" value="CORPSQL19DV01"/>

  <targets>
    <default-wrapper xsi:type="AsyncWrapper" overflowAction="Discard" queueLimit="10000" batchSize="100" timeToSleepBetweenBatches="50" />
    <target xsi:type="File"
            name="f"
            fileName="c:/temp/logs/${shortdate}/${serviceName}/${callsite:methodname=False}.log"
            layout="${longdate} ${uppercase:${level}} ${windows-identity} ${callsite} ${message}">
    </target>
    <target xsi:type="BufferingWrapper"
            name="mb"
            slidingTimeout="true"
            flushTimeout="300000"
            bufferSize="50">
      <target name="m"
              xsi:type="Mail"
              smtpServer="cardinalcorp-com.mail.protection.outlook.com"
              from="svcsoa@cardinalcorp.com"
              to="jkjeer@cardinalcorp.com"
              layout="Date: ${longdate} ${newline} Machine: ${machinename} ${newline} Domain: ${appdomain} ${newline} Process: ${processid} ${newline} Identity: ${windows-identity} ${newline} Callsite: ${callsite} ${newline} Level: ${uppercase:${level}} ${newline} Comments: ${event-context:item=COMMENTS} ${newline} Message: ${message} ${newline} Stacktrace: ${stacktrace} ${newline} ${newline}"
              subject="${machinename} - ${serviceName} - ${event-context:item=CONTRACT_NAME}">
      </target>
    </target>
    <target xsi:type="Database" name="d"
            connectionString="Data Source=${LogDbHost};Initial Catalog=INTEGRATION;Integrated Security=SSPI;"
            keepConnection="true"
            dbProvider="System.Data.SqlClient"
            commandText="INSERT INTO EVENT_LOG (EVENT_DATE, EVENT_TYPE, USER_NAME, OPERATION_NAME, CONTRACT_NAME, LOG_INTERFACE, ARGUMENTS, HOST_NAME, SCHEME, PORT, SERVER_ADDRESS, SESSION_ID, ELAPSED_MS, COMMENTS) VALUES (@EVENT_DATE, @EVENT_TYPE, @USER_NAME, @OPERATION_NAME, @CONTRACT_NAME, @LOG_INTERFACE, @ARGUMENTS, @HOST_NAME, @SCHEME, @PORT, @SERVER_ADDRESS, @SESSION_ID, @ELAPSED_MS, @COMMENTS);">
      <parameter name="@EVENT_DATE" layout="${event-context:item=EVENT_DATE}"/>
      <parameter name="@EVENT_TYPE" layout="${event-context:item=EVENT_TYPE}"/>
      <parameter name="@USER_NAME" layout="${event-context:item=USER_NAME}"/>
      <parameter name="@OPERATION_NAME" layout="${event-context:item=OPERATION_NAME}"/>
      <parameter name="@CONTRACT_NAME" layout="${event-context:item=CONTRACT_NAME}"/>
      <parameter name="@LOG_INTERFACE" layout="${event-context:item=LOG_INTERFACE}"/>
      <parameter name="@ARGUMENTS" layout="${event-context:item=ARGUMENTS}"/>
      <parameter name="@HOST_NAME" layout="${event-context:item=HOST_NAME}"/>
      <parameter name="@SCHEME" layout="${event-context:item=SCHEME}"/>
      <parameter name="@PORT" layout="${event-context:item=PORT}"/>
      <parameter name="@SERVER_ADDRESS" layout="${event-context:item=SERVER_ADDRESS}"/>
      <parameter name="@SESSION_ID" layout="${event-context:item=SESSION_ID}"/>
      <parameter name="@ELAPSED_MS" layout="${event-context:item=ELAPSED_MS}"/>
      <parameter name="@COMMENTS" layout="${event-context:item=COMMENTS}"/>
    </target>
    <target xsi:type="Database" name="pl"
            connectionString="Data Source=${LogDbHost};Initial Catalog=INTEGRATION;Integrated Security=SSPI"
            keepConnection="true"
            dbProvider="System.Data.SqlClient"
            commandText="INSERT INTO SVC.PROCESS_LOG (EVENT_DATE, PLANT_CD, PROCESS, STATUS, START_DATE, END_DATE, ROWS_AFFECTED, CONNECTION_STRINGS, STEPS, SERVICE_CONTEXT, ERRORS, RESPONSE) 
                                                VALUES (@EVENT_DATE, @PLANT, @PROCESS, @STATUS, @START_DATE, @END_DATE, @ROWS_AFFECTED, @CONNECTION_STRINGS, @STEPS, @SERVICE_CONTEXT, @ERRORS, @RESPONSE);">
      <parameter name="@EVENT_DATE" layout="${event-context:item=EVENT_DATE}"/>
      <parameter name="@PLANT" layout="${event-context:item=PLANT}"/>
      <parameter name="@PROCESS" layout="${event-context:item=PROCESS}"/>
      <parameter name="@STATUS" layout="${event-context:item=STATUS}"/>
      <parameter name="@START_DATE" layout="${event-context:item=START_DATE}"/>
      <parameter name="@END_DATE" layout="${event-context:item=END_DATE}"/>
      <parameter name="@ROWS_AFFECTED" layout="${event-context:item=ROWS_AFFECTED}"/>
      <parameter name="@CONNECTION_STRINGS" layout="${event-context:item=CONNECTION_STRINGS}"/>
      <parameter name="@STEPS" layout="${event-context:item=STEPS}"/>
      <parameter name="@SERVICE_CONTEXT" layout="${event-context:item=SERVICE_CONTEXT}"/>
      <parameter name="@ERRORS" layout="${event-context:item=ERRORS}"/>
      <parameter name="@RESPONSE" layout="${event-context:item=RESPONSE}"/>
    </target>
  </targets>

  <rules>
    <logger name="ProcessLog" minlevel="Info" writeTo="pl" />
    <logger name="SoaCore.Wcf.*" minlevel="Info" writeTo="f" />
    <logger name="SoaCore.Wcf.*" minlevel="Info" writeTo="d" />
    <logger name="SoaCore.Wcf.*" minlevel="Error" writeTo="mb" />
    <logger name="ArchiveServices.*" minlevel="Trace" writeTo="f" />
    <logger name="ArchiveServices.*" minlevel="Error" writeTo="m" />
  </rules>

</nlog>